# Settings LessonBloom reads from the ENVIRONMENT (the app does not load this file; it is a list only).
# Local development with an AI Studio key (unset: the app runs on the mock provider)
# GEMINI_API_KEY=

# On Cloud Run (set by deploy.sh): Vertex AI + Firestore + Cloud Storage
# GOOGLE_GENAI_USE_VERTEXAI=true
# GOOGLE_CLOUD_PROJECT=your-project-id
# GOOGLE_CLOUD_LOCATION=global
# LB_BUCKET=lessonbloom-media-your-project
# LB_ADMIN_KEY=            (from Secret Manager on Cloud Run)
# LB_SMTP_KEY=             (from Secret Manager on Cloud Run; empty: codes are printed to the log)
# SMTP_USER= SMTP_SERVER= LB_MAIL_FROM="LessonBloom" <no-reply@your-domain>
