{
  "name": "lessonbloom",
  "version": "0.1.0",
  "private": true,
  "description": "Lesson notes to slides, narrated video and worksheets for primary teachers. Gemini on Google Cloud. AI Builder Cup 2026.",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev:api": "tsx watch server/main.ts",
    "make": "tsx server/cli.ts",
    "test": "tsx --test server/test/*.test.ts",
    "typecheck": "tsc --noEmit && tsc --noEmit -p web",
    "dev:web": "vite --config web/vite.config.ts",
    "build": "vite build --config web/vite.config.ts",
    "start": "tsx server/main.ts"
  },
  "dependencies": {
    "@google/genai": "^2.29.0",
    "@hono/node-server": "^2.1.5",
    "hono": "^4.13.13",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.4"
  }
}
